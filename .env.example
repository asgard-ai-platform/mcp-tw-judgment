# =============================================================================
# mcp-tw-judgment — Environment Variables
# =============================================================================
# 司法院裁判書系統 is a public endpoint — no authentication is required.
# This file is intentionally empty; kept as a placeholder for future settings.

# Optional: directory where get_judgment_pdf writes downloaded PDFs.
# If unset and the tool's save_to arg is not provided, only the URL is returned.
# MCP_TW_JUDGMENT_DOWNLOAD_DIR=~/Downloads/tw-judgments
